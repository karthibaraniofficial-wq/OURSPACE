# ==============================================================================
# OURSPACE — Development Environment Template (.env.development.example)
# ==============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Client Configuration (Development / Emulator Project)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDevKeyPlaceholder
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ourspace-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ourspace-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ourspace-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:devPlaceholderAppId
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BNdevVapidPlaceholder

# LiveKit WebRTC Configuration (Development Cloud or Local)
NEXT_PUBLIC_LIVEKIT_URL=wss://ourspace-dev.livekit.cloud
LIVEKIT_API_KEY=dev_livekit_key
LIVEKIT_API_SECRET=dev_livekit_secret

# GIPHY Integration
NEXT_PUBLIC_GIPHY_API_KEY=dev_giphy_key
