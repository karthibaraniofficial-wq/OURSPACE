# ==============================================================================
# OURSPACE — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit files containing real production secrets to Git!

# Public Firebase Configuration (Client-Safe)
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_FCM_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-YOUR_MEASUREMENT_ID
NEXT_PUBLIC_FIREBASE_VAPID_KEY=YOUR_PUBLIC_VAPID_KEY_FOR_WEB_PUSH

# LiveKit Global WebRTC SFU (Public Signaling Endpoint)
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Server-Only LiveKit Token Minting (Server / API Route / Functions Only)
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# Optional Integrations
NEXT_PUBLIC_GIPHY_API_KEY=YOUR_GIPHY_API_KEY
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_V3_SITE_KEY

# Application Public URL
NEXT_PUBLIC_APP_URL=https://ourspace.app

# ==============================================================================
# Central Google Drive Media Storage & 250 GB Quota (Server-Only Secrets)
# Connects administrator's personal Google AI Pro account as the single media vault.
# Couple partners NEVER need Google accounts or credentials.
# ==============================================================================
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://ourspace-app-two.vercel.app/api/drive/callback
GOOGLE_DRIVE_REFRESH_TOKEN=YOUR_OFFLINE_REFRESH_TOKEN_OPTIONAL
GOOGLE_DRIVE_ROOT_FOLDER_ID=YOUR_ROOT_FOLDER_ID_OPTIONAL

