# ==============================================================================
# OURSPACE — Production Environment Template (.env.production.example)
# ==============================================================================
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://ourspace.app

# Firebase Client Configuration (Production Google Cloud Project)
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_PRODUCTION_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-production-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-production-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-production-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_PRODUCTION_FCM_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_PRODUCTION_FIREBASE_APP_ID
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-YOUR_PROD_MEASUREMENT_ID
NEXT_PUBLIC_FIREBASE_VAPID_KEY=YOUR_PRODUCTION_VAPID_KEY

# LiveKit Global WebRTC SFU Cloud Endpoint (WSS over TLS)
NEXT_PUBLIC_LIVEKIT_URL=wss://your-production.livekit.cloud
LIVEKIT_API_KEY=YOUR_PRODUCTION_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_PRODUCTION_LIVEKIT_API_SECRET

# Optional App Check / GIPHY
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=YOUR_PRODUCTION_RECAPTCHA_KEY
NEXT_PUBLIC_GIPHY_API_KEY=YOUR_PRODUCTION_GIPHY_KEY

# Server-Only Service Account (Vercel Server Secret / Cloud Functions Secret)
# FIREBASE_PROJECT_ID=your-production-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-production-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
