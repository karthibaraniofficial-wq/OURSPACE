# ==============================================================================
# OURSPACE — Production .gitignore
# ==============================================================================

# Dependencies
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js Build Outputs
apps/web/.next/
apps/web/out/
apps/web/build/
.next/
out/
build/
dist/
*.tsbuildinfo

# Expo / React Native
apps/mobile/.expo/
apps/mobile/.expo-shared/
.expo/
*.orig.*

# Environment Files (Keep only example templates)
.env*
!.env.example
!.env.development.example
!.env.production.example

# Credentials, Keys & Private Certificates
*.pem
*.key
*.cert
*.crt
*.keystore
*.jks
*.p8
*.p12
*service-account*.json
*serviceAccount*.json
firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Directories
.idea/
.vscode/
*.swp
*.swo

# Cloud Functions
functions/node_modules/

# Test Coverage
coverage/
.nyc_output/

.vercel
.env*
