rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for all unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isMemberOfSpace(spaceId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/privateSpaces/$(spaceId)/members/$(request.auth.uid));
    }

    function canReadUserProfile(uid) {
      return isAuthenticated() && (
        // User reading their own profile
        request.auth.uid == uid ||
        // Partner reading co-member profile within authorized private space
        (resource.data.activeSpaceId != null &&
         exists(/databases/$(database)/documents/privateSpaces/$(resource.data.activeSpaceId)/members/$(request.auth.uid)))
      );
    }

    // 1. User Profiles & Devices
    match /users/{uid} {
      allow read: if canReadUserProfile(uid);
      allow create: if isUser(uid);
      allow update: if isUser(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'email', 'createdAt']);
      allow delete: if isUser(uid);


      match /devices/{deviceId} {
        allow read, write: if isUser(uid);
      }

      match /settings/{settingId} {
        allow read, write: if isUser(uid);
      }

      // Our Locker: Encrypted Private Vault
      match /personalVault/{vaultId} {
        allow read, write: if isUser(uid);

        match /items/{itemId} {
          allow read, write: if isUser(uid);
        }

        match /folders/{folderId} {
          allow read, write: if isUser(uid);
        }
      }

      // Our Locker: Google Drive & Cloud Encrypted Backups
      match /secureLockerBackups/{backupId} {
        allow read, write: if isUser(uid);
      }
    }

    // 2. Invitations (Controlled couple pairing)
    match /invitations/{code} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && (
        // Creator revoking their own invitation
        (resource.data.createdBy == request.auth.uid && request.resource.data.status == 'revoked') ||
        // Unpaired partner accepting pending invite
        (resource.data.status == 'pending' &&
         request.resource.data.status == 'accepted' &&
         request.resource.data.acceptedBy == request.auth.uid)
      );
    }

    // 3. Private Spaces (Strict 2-member limit)
    match /privateSpaces/{spaceId} {
      // Allow read if already member OR if authenticated user inspecting capacity to join
      allow read: if isMemberOfSpace(spaceId) || (isAuthenticated() && resource.data.memberCount < 2);
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid && request.resource.data.memberCount == 1;
      // Allow update if member OR if authenticated partner incrementing memberCount from 1 to 2 upon joining
      allow update: if (isMemberOfSpace(spaceId) || (isAuthenticated() && resource.data.memberCount == 1)) && request.resource.data.memberCount <= 2;
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;

      // Space Members (Hard boundary ceiling)
      match /members/{memberUid} {
        allow read: if isMemberOfSpace(spaceId);
        allow create: if isAuthenticated() && request.auth.uid == memberUid && (
          // Creator adding themselves initially
          (request.resource.data.role == 'creator' &&
           get(/databases/$(database)/documents/privateSpaces/$(spaceId)).data.memberCount <= 1) ||
          // Partner redeeming invitation, space must have capacity (< 2)
          (request.resource.data.role == 'partner' &&
           get(/databases/$(database)/documents/privateSpaces/$(spaceId)).data.memberCount < 2)
        );
        allow delete: if isUser(memberUid);
      }

      // Conversations & Messages
      match /conversations/{conversationId} {
        allow read, write: if isMemberOfSpace(spaceId);

        match /messages/{messageId} {
          allow read: if isMemberOfSpace(spaceId);
          allow create: if isMemberOfSpace(spaceId) && request.resource.data.senderId == request.auth.uid;
          allow update: if isMemberOfSpace(spaceId) && (
            resource.data.senderId == request.auth.uid ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'readBy', 'pinned'])
          );
          allow delete: if isMemberOfSpace(spaceId) && resource.data.senderId == request.auth.uid;
        }
      }

      // Reminders
      match /reminders/{reminderId} {
        allow read, write: if isMemberOfSpace(spaceId);
      }

      // Shared Events & Milestones
      match /events/{eventId} {
        allow read, write: if isMemberOfSpace(spaceId);
      }

      // Media Vault Files
      match /mediaFiles/{fileId} {
        allow read: if isMemberOfSpace(spaceId);
        allow create: if isMemberOfSpace(spaceId) && request.resource.data.uploadedBy == request.auth.uid;
        allow update, delete: if isMemberOfSpace(spaceId);
      }

      // Memory Albums & Album Items
      match /albums/{albumId} {
        allow read, write: if isMemberOfSpace(spaceId);

        match /items/{itemId} {
          allow read, write: if isMemberOfSpace(spaceId);
        }
      }

      // Couple Planning Hub (Bucket List, Date Plans, Travel, Goals, Expenses)
      match /bucketList/{itemId} {
        allow read, write: if isMemberOfSpace(spaceId);
      }
      match /datePlans/{planId} {
        allow read, write: if isMemberOfSpace(spaceId);
      }
      match /travelPlans/{planId} {
        allow read, write: if isMemberOfSpace(spaceId);
      }
      match /shoppingLists/{listId} {
        allow read, write: if isMemberOfSpace(spaceId);
      }
      match /goals/{goalId} {
        allow read, write: if isMemberOfSpace(spaceId);
      }
      match /expenses/{expenseId} {
        allow read, write: if isMemberOfSpace(spaceId);
      }
      match /letters/{letterId} {
        allow read, write: if isMemberOfSpace(spaceId);
      }
      match /dailyConnect/{entryId} {
        allow read, write: if isMemberOfSpace(spaceId);
      }
      match /relationshipJournal/{entryId} {
        allow read, write: if isMemberOfSpace(spaceId);
      }

      // WebRTC Call Sessions
      match /callSessions/{callId} {
        allow read, write: if isMemberOfSpace(spaceId);
      }

      // Audit Logs
      match /auditLogs/{logId} {
        allow read: if isMemberOfSpace(spaceId);
        allow create: if isMemberOfSpace(spaceId);
      }
    }
  }
}
